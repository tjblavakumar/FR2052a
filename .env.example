# Copy this file to .env and fill in your values. .env is gitignored.
# Used only by tools/generate_profiles.py (LLM profile generation).
# The data generator itself never needs these.

OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Pick a model that reliably returns JSON. Verified: google/gemma-4-26b-a4b-it,
# deepseek/deepseek-v3.2. Avoid ":free" variants (rate-limited / HTTP 429).
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it
